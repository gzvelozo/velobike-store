# ─────────────────────────────────────────────────────────────────────────────
# VELOBIKE / velomedStore — Environment Variables Template
#
# Copy this file to `.env.local` and fill in the values for local development.
# For production, set these in the Vercel dashboard or via `vercel env add`.
#
# Vercel CLI quick reference:
#   vercel env ls                          # list all env vars per environment
#   vercel env add <NAME> production       # add a new var (will prompt for value)
#   vercel env rm <NAME> production        # remove a var
#   vercel env pull .env.local             # download to local file (for dev)
# ─────────────────────────────────────────────────────────────────────────────

# ── Stripe ────────────────────────────────────────────────────────────────────
# Get keys from https://dashboard.stripe.com/test/apikeys (test mode)
# or https://dashboard.stripe.com/apikeys (live mode).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# REQUIRED for /api/webhooks/stripe to verify webhook signatures.
# Without this, the webhook route returns 500 and orders never persist.
#
# Local dev: install Stripe CLI, then run:
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe
# It will print a `whsec_...` value — paste it below.
#
# Production: in Stripe Dashboard → Developers → Webhooks → Add endpoint
#   URL:      https://velobike-store-one.vercel.app/api/webhooks/stripe
#   Events:   checkout.session.completed, checkout.session.expired
# Copy the "Signing secret" (starts with `whsec_`) → `vercel env add STRIPE_WEBHOOK_SECRET production`
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get values from https://supabase.com/dashboard/project/<your-project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# REQUIRED for the Stripe webhook to write orders (bypasses RLS).
# NEVER expose this to the client. Server-only.
# Get it from Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── VeloMED handoff ───────────────────────────────────────────────────────────
# VELOBIKE calls VeloMED to mint a qualification token, then redirects the
# shopper to NEXT_PUBLIC_VELOMED_QUALIFY_URL?token=<token>.
#
# Production values (already set in Vercel):
#   VELOMED_API_URL=https://velomed-dev-api.delightfulbeach-298473ed.eastus2.azurecontainerapps.io
#   NEXT_PUBLIC_VELOMED_QUALIFY_URL=https://velomed-marketplace.vercel.app/qualify
#
# Local dev options:
#   (a) Run VeloMED locally — point at http://localhost:5000 (API) and http://localhost:3001/qualify
#   (b) Point dev at the live Azure stack — paste the production URLs above
#   (c) Leave both blank — /api/handoff falls back to a `demo-<uuid>` token (offline demo mode)
VELOMED_API_URL=http://localhost:5000
VELOMED_API_KEY=demo-api-key
NEXT_PUBLIC_VELOMED_QUALIFY_URL=http://localhost:3001/qualify

# ── App ───────────────────────────────────────────────────────────────────────
# Used by Stripe for success/cancel redirect URLs. Set per environment.
NEXT_PUBLIC_APP_URL=http://localhost:3000
